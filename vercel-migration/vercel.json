      "destination": "/product-slippers",
      "statusCode": 301
    },
    {
      "source": "/chym-vidriznyayutsya-gotelni-rushnyky-vid-zvychajnyh/",
      "destination": "/product-towels",
      "statusCode": 301
    },
    {
