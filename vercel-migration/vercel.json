{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run sync && npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about-us/",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/contact-us/",
      "destination": "/#footer-contacts",
      "statusCode": 301
    },
    {
      "source": "/catalog/",
      "destination": "/products",
      "statusCode": 301
    },
    {
      "source": "/shop/",
      "destination": "/products",
      "statusCode": 301
    },
    {
      "source": "/pro-kompaniyu/",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/kontakti/",
      "destination": "/#footer-contacts",
      "statusCode": 301
    },
    {
      "source": "/partneram/",
      "destination": "/proposal",
      "statusCode": 301
    },
    {
      "source": "/o-nas/",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/horeca/",
      "destination": "/hotel-textile",
      "statusCode": 301
    },
    {
      "source": "/optovym-pokupatelyam/",
      "destination": "/proposal",
      "statusCode": 301
    },
    {
      "source": "/dlya-horeca/",
      "destination": "/hotel-textile",
      "statusCode": 301
    },
    {
      "source": "/individualnye-uslugi/",
      "destination": "/proposal",
      "statusCode": 301
    },
    {
      "source": "/korporativnym-klientam/",
      "destination": "/proposal",
      "statusCode": 301
    },
    {
      "source": "/chomu-perkal/",
      "destination": "/product-bed-linen",
      "statusCode": 301
    },
    {
      "source": "/navishho-potribni-gotelni-kaptsi-i-chy-mozhna-bez-nyh-obijtysya/",
      "destination": "/product-slippers",
      "statusCode": 301
    },
    {
